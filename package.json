{
  "name": "@koda.sh/motif-categorize",
  "version": "0.1.0",
  "description": "Composite fingerprint collections for fast set-level categorization and similarity comparison powered by @koda.sh/motif-core",
  "license": "MPL-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "categorize",
    "collections",
    "composite",
    "minhash",
    "fingerprint",
    "similarity",
    "motif"
  ],
  "author": "Koda.sh",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@koda.sh/motif-core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.0"
  }
}
